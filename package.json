{
  "name": "narrative-analytics-insight-engine",
  "version": "1.0.0",
  "description": "Narrative analytics engine for analyzing content themes, arcs, and engagement",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend",
    "test": "npm run test -w backend",
    "test:watch": "npm run test:watch -w backend",
    "test:coverage": "npm run test:coverage -w backend",
    "lint": "npm run lint -w backend",
    "lint:fix": "npm run lint:fix -w backend",
    "format": "npm run format -w backend",
    "typecheck": "npm run typecheck -w backend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose down && docker-compose build && docker-compose up -d",
    "db:migrate": "npm run db:migrate -w backend",
    "db:push": "npm run db:push -w backend",
    "db:seed": "npm run db:seed -w backend",
    "db:studio": "npm run db:studio -w backend",
    "db:reset": "npm run db:reset -w backend",
    "cli": "npm run cli -w backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
